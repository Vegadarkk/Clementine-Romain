# Copier ce fichier en C:\Users\<utilisateur>\cles\llm-council.env (JAMAIS dans un dépôt)

# --- Conseil payant (ChatGPT + Gemini) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_MODEL=gemini-3-flash-preview

# --- Conseil gratuit (freellmpool) : toutes facultatives ---
# Sans aucune clé, freellmpool utilise les fournisseurs sans inscription (Pollinations, OVHcloud, Kilo, LLM7).
# Chaque clé gratuite ajoutée élargit le panel et les quotas. Inscriptions : https://github.com/0xzr/freellmpool/blob/main/docs/ACCOUNTS.md
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
REQUESTY_API_KEY=
AION_API_KEY=
